PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chat_app

# URL pública del chat (para armar URLs absolutas de imágenes)
PUBLIC_URL=http://localhost:3000

# Clave que n8n debe enviar en el header x-api-key
API_KEY=

# Webhook de n8n que recibe los mensajes de los clientes
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Mercado Pago (cuenta de la empresa)
# Access token de producción o de prueba
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones > Webhooks)
MP_WEBHOOK_SECRET=

# Secreto para firmar los links de referido. NO cambiarlo: invalida todos los links ya publicados
REF_LINK_SECRET=

# 1 si el servidor está detrás de un proxy (Nginx, Cloudflare) para usar la IP real
TRUST_PROXY=0

# CRM (leadsgg): crea el lead cuando el cliente acepta continuar (tablero Comercial).
# Mismo valor que API_TOKEN del .env del CRM. Si se dejan vacíos, solo se genera el código.
CRM_URL=
CRM_API_TOKEN=

# Links de descarga de la app GEVHE (opcional, ya tienen valor por defecto)
APP_ANDROID_URL=
APP_IOS_URL=
