PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chat_app

# URL pública del chat (para armar URLs absolutas de imágenes)
PUBLIC_URL=http://localhost:3000

# Clave que n8n debe enviar en el header x-api-key
API_KEY=

# Webhook de n8n que recibe los mensajes de los clientes
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Mercado Pago (cuenta de la empresa)
# Access token de producción o de prueba
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones > Webhooks)
MP_WEBHOOK_SECRET=

# Secreto para firmar los links de referido. NO cambiarlo: invalida todos los links ya publicados
REF_LINK_SECRET=

# 1 si el servidor está detrás de un proxy (Nginx, Cloudflare) para usar la IP real
TRUST_PROXY=0

# CRM (leadsgg): crea el lead con el primer mensaje del cliente (tablero Comercial, columna Web)
# y lo regresa a la primera columna si no acepta la cotización.
# Mismo valor que API_TOKEN del .env del CRM. Si se dejan vacíos, no se crean leads.
CRM_URL=
CRM_API_TOKEN=

# SIGEV: usuario de SIGEV (que también sea socio) con el que el chat genera las cotizaciones
# de costo fijo (COTA…). Si se dejan vacíos, esos clientes reciben una precotización PRE.
SIGEV_URL=https://my.grupogevhe.com

# Pruebas automáticas de conversación (npm run conversar): link de referido de cualquier influencer
PRUEBAS_LINK=
SIGEV_EMAIL=
SIGEV_PASSWORD=

# Links de descarga de la app GEVHE (opcional, ya tienen valor por defecto)
APP_ANDROID_URL=
APP_IOS_URL=

# Saludo automático de la influencer al abrir una conversación nueva (off = sin saludo)
GREETING_MESSAGE=
